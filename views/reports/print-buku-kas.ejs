<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; padding: 0 !important; }
      .bku-paper { border: none !important; box-shadow: none !important; width: 100% !important; margin: 0 !important; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen py-8 px-4 flex flex-col items-center font-sans text-slate-900">

  <!-- Action Bar (Hidden on print) -->
  <div class="no-print max-w-4xl w-full mb-4 flex items-center justify-between">
    <a href="/audit" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700 hover:bg-slate-50 transition shadow-sm">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Kembali ke Audit</span>
    </a>

    <div class="flex items-center gap-3">
      <button onclick="window.print()" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-md shadow-brand-500/25 transition">
        <i class="fa-solid fa-print"></i>
        <span>Cetak Laporan / Simpan PDF</span>
      </button>
    </div>
  </div>

  <!-- Print Sheet Container (A4 Style) -->
  <div class="bku-paper max-w-4xl w-full bg-white rounded-2xl border border-slate-300 p-8 sm:p-12 shadow-xl">
    
    <!-- Kop Surat Resmi Sekolah -->
    <div class="border-b-2 border-slate-900 pb-4 text-center">
      <div class="text-xs font-extrabold uppercase tracking-widest text-slate-500">Pemerintah Provinsi Jawa Barat &bull; Dinas Pendidikan</div>
      <h1 class="text-xl font-black text-slate-900 uppercase tracking-tight mt-0.5">SMK NEGERI REKAYASA PERANGKAT LUNAK</h1>
      <p class="text-xs text-slate-600">Jalan Pendidikan Vokasi No. 101, Kota Pendidikan - Telp (021) 7890123</p>
      <div class="mt-3 py-1 px-4 inline-block bg-slate-900 text-white text-xs font-black tracking-wider uppercase rounded">
        BUKU KAS UMUM (BKU) KELAS XII RPL 1
      </div>
      <div class="text-xs text-slate-600 font-semibold mt-1">
        Periode Laporan: Tahun Ajaran 2026/2027
      </div>
    </div>

    <!-- Ringkasan Saldo Box -->
    <div class="grid grid-cols-3 gap-4 my-6 text-xs">
      <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
        <span class="text-[10px] text-emerald-800 font-bold uppercase block">Total Penerimaan (Debet)</span>
        <span class="text-base font-black text-emerald-700"><%= formatRupiah(totalMasuk) %></span>
      </div>
      <div class="p-3 rounded-xl bg-rose-50 border border-rose-200">
        <span class="text-[10px] text-rose-800 font-bold uppercase block">Total Pengeluaran (Kredit)</span>
        <span class="text-base font-black text-rose-700"><%= formatRupiah(totalKeluar) %></span>
      </div>
      <div class="p-3 rounded-xl bg-blue-50 border border-blue-200">
        <span class="text-[10px] text-blue-800 font-bold uppercase block">Saldo Akhir Buku Kas</span>
        <span class="text-base font-black text-brand-700"><%= formatRupiah(saldoAkhir) %></span>
      </div>
    </div>

    <!-- Tabel BKU Kronologis -->
    <div class="overflow-x-auto my-4">
      <table class="w-full text-left border-collapse border border-slate-300 text-xs">
        <thead>
          <tr class="bg-slate-100 text-slate-800 font-black uppercase text-center border-b border-slate-300">
            <th class="border border-slate-300 py-2 px-2.5 w-10">No</th>
            <th class="border border-slate-300 py-2 px-3 w-28">Tanggal</th>
            <th class="border border-slate-300 py-2 px-4 text-left">Uraian / Keterangan Transaksi</th>
            <th class="border border-slate-300 py-2 px-3 text-right w-28">Penerimaan (Debet)</th>
            <th class="border border-slate-300 py-2 px-3 text-right w-28">Pengeluaran (Kredit)</th>
            <th class="border border-slate-300 py-2 px-3 text-right w-32">Saldo (Rp)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium">
          <% logs.forEach(row => { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="border border-slate-300 py-2 px-2.5 text-center font-mono"><%= row.no %></td>
              <td class="border border-slate-300 py-2 px-3 text-center"><%= row.tanggal %></td>
              <td class="border border-slate-300 py-2 px-4"><%= row.keterangan %></td>
              <td class="border border-slate-300 py-2 px-3 text-right font-mono <%= row.debet > 0 ? 'font-bold text-emerald-700' : 'text-slate-400' %>">
                <%= row.debet > 0 ? formatRupiah(row.debet) : '-' %>
              </td>
              <td class="border border-slate-300 py-2 px-3 text-right font-mono <%= row.kredit > 0 ? 'font-bold text-rose-700' : 'text-slate-400' %>">
                <%= row.kredit > 0 ? formatRupiah(row.kredit) : '-' %>
              </td>
              <td class="border border-slate-300 py-2 px-3 text-right font-mono font-black text-slate-900">
                <%= formatRupiah(row.saldo) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr class="bg-slate-100 font-black border-t-2 border-slate-400">
            <td colspan="3" class="border border-slate-300 py-2.5 px-4 text-right uppercase">JUMLAH TOTAL</td>
            <td class="border border-slate-300 py-2.5 px-3 text-right font-mono text-emerald-800"><%= formatRupiah(totalMasuk) %></td>
            <td class="border border-slate-300 py-2.5 px-3 text-right font-mono text-rose-800"><%= formatRupiah(totalKeluar) %></td>
            <td class="border border-slate-300 py-2.5 px-3 text-right font-mono text-slate-950 font-black"><%= formatRupiah(saldoAkhir) %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Lembar Pengesahan 3 Pihak (Wali Kelas, Ketua Kelas, Bendahara) -->
    <div class="mt-12 pt-6 border-t border-slate-300 grid grid-cols-3 gap-4 text-center text-xs">
      <div>
        <div class="text-slate-500">Mengetahui,</div>
        <div class="font-bold text-slate-800">Wali Kelas XII RPL 1</div>
        <div class="h-20 flex items-center justify-center">
          <span class="text-[10px] text-slate-300 italic">[ Tanda Tangan ]</span>
        </div>
        <div class="font-black text-slate-900 underline"><%= waliKelas.nama %></div>
        <div class="text-[10px] text-slate-500 font-mono"><%= waliKelas.nisn || 'NIP. 197805122005011003' %></div>
      </div>

      <div>
        <div class="text-slate-500">Diperiksa Oleh,</div>
        <div class="font-bold text-slate-800">Ketua Kelas XII RPL 1</div>
        <div class="h-20 flex items-center justify-center">
          <span class="text-[10px] text-slate-300 italic">[ Tanda Tangan ]</span>
        </div>
        <div class="font-black text-slate-900 underline">Fadhil Pratama</div>
        <div class="text-[10px] text-slate-500 font-mono">NISN. 0068492001</div>
      </div>

      <div>
        <div class="text-slate-500">Dibuat Oleh,</div>
        <div class="font-bold text-slate-800">Bendahara Kelas XII RPL 1</div>
        <div class="h-20 flex items-center justify-center">
          <div class="border border-red-400 text-red-500 rounded px-2 py-0.5 text-[9px] font-bold rotate-[-3deg]">
            TERVERIFIKASI SISTEM
          </div>
        </div>
        <div class="font-black text-slate-900 underline"><%= bendahara.nama %></div>
        <div class="text-[10px] text-slate-500 font-mono">NISN. <%= bendahara.nisn || '0068492011' %></div>
      </div>
    </div>

    <!-- Footer Notice -->
    <div class="mt-10 text-center text-[10px] text-slate-400 border-t border-dashed border-slate-200 pt-3">
      Dicetak secara otomatis melalui SiKas Pintar &bull; Aplikasi Sistem Manajemen Kas Kelas &amp; Ekskul
    </div>
  </div>

</body>
</html>
