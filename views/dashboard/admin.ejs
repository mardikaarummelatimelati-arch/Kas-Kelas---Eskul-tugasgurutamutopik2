<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="lg:pl-72 flex flex-col flex-1 min-h-screen">
  <%- include('../layouts/navbar') %>

  <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6">
    <!-- Welcome Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-purple-800 via-indigo-800 to-brand-800 p-6 sm:p-8 text-white shadow-xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-purple-100 backdrop-blur-sm mb-3">
            <i class="fa-solid fa-user-shield"></i> Hak Akses: Administrator / Wali Kelas
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Selamat Datang, <%= user.nama %></h1>
          <p class="text-sm text-purple-200 mt-1 max-w-2xl">
            Sistem Pemantauan Kas Kelas XII RPL 1. Anda memiliki hak penuh untuk menyetujui pengeluaran dana besar, memantau audit mutasi, dan mengelola pengguna.
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/expenses/approvals" class="px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs shadow-lg shadow-amber-400/20 flex items-center gap-2 transition">
            <i class="fa-solid fa-stamp"></i>
            <span>Cek Usulan Dana (<%= pendingExpenses.length %>)</span>
          </a>
          <a href="/audit/print" target="_blank" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs backdrop-blur-sm border border-white/20 flex items-center gap-2 transition">
            <i class="fa-solid fa-print"></i>
            <span>Cetak BKU</span>
          </a>
        </div>
      </div>
      <!-- Background pattern -->
      <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
        <i class="fa-solid fa-shield-halved text-[220px]"></i>
      </div>
    </div>

    <!-- 4 Key Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Card Saldo -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Saldo Kas Total</span>
          <div class="h-10 w-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-vault"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-slate-900 tracking-tight"><%= formatRupiah(summary.currentBalance) %></div>
          <div class="mt-1 flex items-center gap-1.5 text-xs text-emerald-600 font-semibold">
            <i class="fa-solid fa-circle-check"></i>
            <span>Saldo Real-Time</span>
          </div>
        </div>
      </div>

      <!-- Card Kas Masuk -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Kas Masuk</span>
          <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-arrow-down-left"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-emerald-600 tracking-tight"><%= formatRupiah(summary.totalIncome) %></div>
          <div class="mt-1 flex items-center gap-1.5 text-xs text-slate-500">
            <span>Dari iuran wajib siswa</span>
          </div>
        </div>
      </div>

      <!-- Card Kas Keluar -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Kas Keluar</span>
          <div class="h-10 w-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-arrow-up-right"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-rose-600 tracking-tight"><%= formatRupiah(summary.totalExpense) %></div>
          <div class="mt-1 flex items-center gap-1.5 text-xs text-slate-500">
            <span>Belanja kelas disetujui</span>
          </div>
        </div>
      </div>

      <!-- Card Usulan Pending -->
      <div class="bg-white rounded-2xl p-5 border border-amber-200 bg-amber-50/20 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Usulan Dana Besar</span>
          <div class="h-10 w-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-lg">
            <i class="fa-solid fa-bell"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-amber-700 tracking-tight"><%= pendingExpenses.length %> Usulan</div>
          <div class="mt-1 flex items-center gap-1.5 text-xs text-amber-700 font-semibold">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Menunggu persetujuan Anda</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Section: Usulan Dana Besar Menunggu Persetujuan Admin -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-5 sm:p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-bold text-slate-900">Usulan Pengeluaran Dana Besar Menunggu Otorisasi</h2>
            <% if (pendingExpenses.length > 0) { %>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200 animate-pulse">
                <%= pendingExpenses.length %> Perlu ACC
              </span>
            <% } %>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Sesuai SOP sekolah, pengeluaran &gt; Rp 150.000 wajib mendapat persetujuan Wali Kelas / Pembina sebelum dana dapat dicairkan.</p>
        </div>
        <a href="/expenses/approvals" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-700">
          <span>Kelola Semua Persetujuan</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <% if (pendingExpenses.length === 0) { %>
        <div class="p-8 text-center">
          <div class="h-12 w-12 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center text-xl mb-3">
            <i class="fa-solid fa-check"></i>
          </div>
          <h3 class="text-sm font-bold text-slate-800">Semua Pengeluaran Telah Bersih</h3>
          <p class="text-xs text-slate-500 mt-1">Tidak ada usulan pengeluaran dana besar yang tertahan saat ini.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50/80 text-slate-500 border-b border-slate-200 font-bold uppercase tracking-wider">
                <th class="py-3 px-4">Tanggal &amp; Kategori</th>
                <th class="py-3 px-4">Judul Belanja / Usulan</th>
                <th class="py-3 px-4">Nominal</th>
                <th class="py-3 px-4">Bukti / Estimasi</th>
                <th class="py-3 px-4 text-center">Aksi Cepat</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium">
              <% pendingExpenses.forEach(exp => { %>
                <tr class="hover:bg-slate-50/60 transition">
                  <td class="py-3 px-4">
                    <div class="font-bold text-slate-800"><%= formatDate(exp.tglPengeluaran, 'short') %></div>
                    <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                      <%= exp.kategori %>
                    </span>
                  </td>
                  <td class="py-3 px-4 max-w-xs">
                    <div class="font-bold text-slate-900"><%= exp.judul %></div>
                    <div class="text-[11px] text-slate-500 line-clamp-1"><%= exp.deskripsi || '-' %></div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Diusulkan oleh: <span class="font-semibold text-slate-600"><%= exp.createdBy ? exp.createdBy.nama : 'Bendahara' %></span></div>
                  </td>
                  <td class="py-3 px-4">
                    <span class="font-extrabold text-amber-700 text-sm"><%= formatRupiah(exp.nominal) %></span>
                  </td>
                  <td class="py-3 px-4">
                    <% if (exp.fotoNotaUrl) { %>
                      <button onclick="previewImage('<%= exp.fotoNotaUrl %>', '<%= exp.judul %>')" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                        <i class="fa-solid fa-image text-brand-600"></i>
                        <span>Lihat Nota</span>
                      </button>
                    <% } else { %>
                      <span class="text-slate-400 italic">Tanpa Foto</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <form action="/expenses/approve/<%= exp.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin menyetujui pengeluaran <%= formatRupiah(exp.nominal) %> ini? Saldo kas akan otomatis terpotong.');">
                        <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition flex items-center gap-1">
                          <i class="fa-solid fa-check"></i>
                          <span>Setujui (ACC)</span>
                        </button>
                      </form>
                      <form action="/expenses/reject/<%= exp.id %>" method="POST" onsubmit="return confirm('Tolak usulan pengeluaran ini?');">
                        <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs border border-rose-200 transition">
                          <i class="fa-solid fa-xmark"></i>
                          <span>Tolak</span>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Section: Mutasi Kas Terbaru & Ringkasan -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- 2 Columns: Audit Trail Mutasi Terbaru -->
      <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 sm:p-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Audit Log Mutasi Saldo Terbaru</h2>
            <p class="text-xs text-slate-500">Histori pergerakan saldo kas kelas secara kronologis</p>
          </div>
          <a href="/audit" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
            <span>Buka Audit Lengkap</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
        </div>

        <div class="space-y-3">
          <% recentLogs.forEach(log => { %>
            <div class="p-3 rounded-xl border border-slate-100 hover:border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-xl flex items-center justify-center shrink-0 <%= log.jenisMutasi === 'MASUK' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                  <i class="fa-solid <%= log.jenisMutasi === 'MASUK' ? 'fa-arrow-down' : 'fa-arrow-up' %> text-sm"></i>
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-800 line-clamp-1"><%= log.keterangan %></div>
                  <div class="text-[10px] text-slate-400 mt-0.5"><%= formatDate(log.createdAt, 'time') %></div>
                </div>
              </div>
              <div class="text-right shrink-0">
                <div class="text-xs font-extrabold <%= log.jenisMutasi === 'MASUK' ? 'text-emerald-600' : 'text-rose-600' %>">
                  <%= log.jenisMutasi === 'MASUK' ? '+' : '-' %><%= formatRupiah(log.nominal) %>
                </div>
                <div class="text-[10px] text-slate-500 font-medium">Saldo: <%= formatRupiah(log.saldoSesudah) %></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- 1 Column: Pengeluaran per Kategori & Quick Tools -->
      <div class="space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 sm:p-6">
          <h2 class="text-base font-bold text-slate-900 mb-3">Distribusi Pengeluaran</h2>
          <div class="space-y-3">
            <% if (categoryExpenses.length === 0) { %>
              <p class="text-xs text-slate-400 italic">Belum ada data pengeluaran disetujui.</p>
            <% } else { %>
              <% categoryExpenses.forEach(c => { 
                const nominal = c._sum.nominal || 0;
                const percent = summary.totalExpense > 0 ? Math.round((nominal / summary.totalExpense) * 100) : 0;
              %>
                <div>
                  <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-bold text-slate-700"><%= c.kategori %></span>
                    <span class="font-extrabold text-slate-900"><%= formatRupiah(nominal) %> (<%= percent %>%)</span>
                  </div>
                  <div class="h-2 w-full rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full bg-brand-600 rounded-full" style="width: <%= percent %>%;"></div>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

        <div class="bg-gradient-to-br from-slate-900 to-indigo-950 rounded-2xl p-5 text-white shadow-lg">
          <div class="text-xs font-bold uppercase tracking-wider text-purple-300">Pusat Otoritas Cepat</div>
          <div class="text-sm font-black mt-1">Pengaturan Kas &amp; Pembukuan</div>
          <div class="grid grid-cols-2 gap-2 mt-4">
            <a href="/users" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-center transition">
              <i class="fa-solid fa-users text-lg text-purple-300 block mb-1"></i>
              <span class="text-[11px] font-bold">Kelola User</span>
            </a>
            <a href="/periods" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-center transition">
              <i class="fa-solid fa-calendar-plus text-lg text-emerald-300 block mb-1"></i>
              <span class="text-[11px] font-bold">Periode Kas</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
