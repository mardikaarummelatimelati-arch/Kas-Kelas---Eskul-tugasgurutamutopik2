<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="lg:pl-72 flex flex-col flex-1 min-h-screen">
  <%- include('../layouts/navbar') %>

  <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6">
    <!-- Welcome Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-emerald-700 via-teal-700 to-cyan-800 p-6 sm:p-8 text-white shadow-xl">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-emerald-100 backdrop-blur-sm mb-3">
            <i class="fa-solid fa-wallet"></i> Hak Akses: Bendahara Siswa
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Halo, <%= user.nama %></h1>
          <p class="text-sm text-emerald-100 mt-1 max-w-2xl">
            Pusat operasional kas kelas. Kelola tagihan iuran siswa, catat belanja peralatan disertai foto nota, dan cetak laporan rekap kas bulanan.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <a href="/incomes" class="px-4 py-2.5 rounded-xl bg-white text-emerald-800 hover:bg-emerald-50 font-bold text-xs shadow-lg shadow-black/10 flex items-center gap-2 transition">
            <i class="fa-solid fa-plus-circle text-emerald-600"></i>
            <span>Catat Kas Masuk</span>
          </a>
          <a href="/expenses" class="px-4 py-2.5 rounded-xl bg-emerald-900/60 hover:bg-emerald-900 text-white font-bold text-xs border border-white/20 flex items-center gap-2 transition">
            <i class="fa-solid fa-receipt"></i>
            <span>Catat Belanja</span>
          </a>
        </div>
      </div>
      <!-- Background pattern -->
      <div class="absolute -right-6 -bottom-10 opacity-10 pointer-events-none">
        <i class="fa-solid fa-calculator text-[220px]"></i>
      </div>
    </div>

    <!-- 4 Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Saldo Kas Tersedia -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Saldo Kas Aktif</span>
          <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-coins"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-slate-900 tracking-tight"><%= formatRupiah(summary.currentBalance) %></div>
          <div class="mt-1 flex items-center gap-1.5 text-xs text-emerald-600 font-semibold">
            <i class="fa-solid fa-check-double"></i>
            <span>Siap digunakan untuk operasional</span>
          </div>
        </div>
      </div>

      <!-- Kas Masuk -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Uang Masuk</span>
          <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-hand-holding-dollar"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-emerald-600 tracking-tight"><%= formatRupiah(summary.totalIncome) %></div>
          <div class="mt-1 text-xs text-slate-500">Iuran siswa terverifikasi</div>
        </div>
      </div>

      <!-- Kas Keluar -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Belanja Kelas</span>
          <div class="h-10 w-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-rose-600 tracking-tight"><%= formatRupiah(summary.totalExpense) %></div>
          <div class="mt-1 text-xs text-slate-500">Pengeluaran &amp; belanja perlengkapan</div>
        </div>
      </div>

      <!-- Jumlah Siswa -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover-lift">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Anggota Kelas</span>
          <div class="h-10 w-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
        <div class="mt-3">
          <div class="text-2xl font-black text-slate-900 tracking-tight"><%= totalSiswa %> Siswa</div>
          <div class="mt-1 text-xs text-indigo-600 font-semibold">Kelas XII RPL 1</div>
        </div>
      </div>
    </div>

    <!-- Progress Tagihan Kas per Periode -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 sm:p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900">Kemajuan Pembayaran Iuran Kas per Periode</h2>
          <p class="text-xs text-slate-500">Persentase siswa yang sudah lunas dan target dana terkumpul</p>
        </div>
        <a href="/periods" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
          <span>Kelola Periode &amp; Tagihan</span>
          <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% periods.forEach(p => { %>
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="text-xs font-extrabold text-slate-900"><%= p.namaPeriode %></h3>
                <span class="text-[11px] text-slate-500 font-medium">Wajib: <%= formatRupiah(p.nominalWajib) %>/siswa</span>
              </div>
              <span class="text-xs font-extrabold px-2 py-0.5 rounded-full <%= p.persentase >= 80 ? 'bg-emerald-100 text-emerald-800' : (p.persentase >= 50 ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800') %>">
                <%= p.persentase %>%
              </span>
            </div>

            <!-- Progress Bar -->
            <div class="mt-3">
              <div class="h-2 w-full rounded-full bg-slate-200 overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: <%= p.persentase %>%;"></div>
              </div>
              <div class="mt-2 flex items-center justify-between text-[11px] text-slate-600 font-semibold">
                <span><%= p.totalLunas %> / <%= p.totalTagihan %> Siswa Lunas</span>
                <span class="text-emerald-700"><%= formatRupiah(p.totalLunas * p.nominalWajib) %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- 2 Columns: Pembayaran Terbaru & Belanja Terbaru -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Kas Masuk Terakhir -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 sm:p-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Pembayaran Iuran Masuk Terakhir</h2>
            <p class="text-xs text-slate-500">Siswa yang baru membayar kas</p>
          </div>
          <a href="/incomes" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
            <span>Lihat Semua</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
        </div>

        <div class="space-y-3">
          <% if (recentIncomes.length === 0) { %>
            <p class="text-xs text-slate-400 italic">Belum ada transaksi pembayaran kas masuk.</p>
          <% } else { %>
            <% recentIncomes.forEach(inc => { %>
              <div class="p-3 rounded-xl border border-slate-100 hover:border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="h-9 w-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs shrink-0">
                    <%= inc.student ? inc.student.nama.charAt(0) : 'S' %>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-slate-800"><%= inc.student ? inc.student.nama : 'Siswa' %></div>
                    <div class="text-[10px] text-slate-500"><%= inc.period ? inc.period.namaPeriode : '-' %> &bull; <%= formatDate(inc.tglBayar, 'short') %></div>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="text-right">
                    <div class="text-xs font-black text-emerald-600"><%= formatRupiah(inc.nominal) %></div>
                    <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-600 border border-slate-200"><%= inc.metodeBayar || 'TUNAI' %></span>
                  </div>
                  <a href="/incomes/receipt/<%= inc.id %>" target="_blank" title="Cetak Kuitansi" class="p-2 text-slate-400 hover:text-brand-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition">
                    <i class="fa-solid fa-receipt text-xs"></i>
                  </a>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Belanja Terakhir -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 sm:p-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900">Belanja &amp; Pengeluaran Kas Terbaru</h2>
            <p class="text-xs text-slate-500">Mutasi belanja perlengkapan kelas</p>
          </div>
          <a href="/expenses" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
            <span>Lihat Semua</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
        </div>

        <div class="space-y-3">
          <% if (recentExpenses.length === 0) { %>
            <p class="text-xs text-slate-400 italic">Belum ada transaksi kas keluar.</p>
          <% } else { %>
            <% recentExpenses.forEach(exp => { %>
              <div class="p-3 rounded-xl border border-slate-100 hover:border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="h-9 w-9 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-bag-shopping text-xs"></i>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-slate-800"><%= exp.judul %></div>
                    <div class="text-[10px] text-slate-500"><%= exp.kategori %> &bull; <%= formatDate(exp.tglPengeluaran, 'short') %></div>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="text-right">
                    <div class="text-xs font-black text-rose-600"><%= formatRupiah(exp.nominal) %></div>
                    <span class="text-[9px] font-bold px-1.5 py-0.2 rounded <%= exp.statusApproval === 'APPROVED' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                      <%= exp.statusApproval %>
                    </span>
                  </div>
                  <% if (exp.fotoNotaUrl) { %>
                    <button onclick="previewImage('<%= exp.fotoNotaUrl %>', '<%= exp.judul %>')" title="Lihat Nota" class="p-2 text-slate-400 hover:text-brand-600 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition">
                      <i class="fa-solid fa-image text-xs"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
