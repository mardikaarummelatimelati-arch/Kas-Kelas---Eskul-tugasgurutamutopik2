<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; padding: 0 !important; }
      .kuitansi-box { border: 2px solid #000 !important; box-shadow: none !important; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen py-8 px-4 flex flex-col items-center justify-center font-sans text-slate-800">

  <!-- Top Action Bar (No-Print) -->
  <div class="no-print max-w-2xl w-full mb-4 flex items-center justify-between">
    <a href="/student/tagihan" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700 hover:bg-slate-50 transition shadow-sm">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Kembali</span>
    </a>

    <div class="flex items-center gap-2">
      <button onclick="window.print()" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-md shadow-brand-500/25 transition">
        <i class="fa-solid fa-print"></i>
        <span>Cetak Kuitansi / Simpan PDF</span>
      </button>
    </div>
  </div>

  <!-- Kuitansi Card Container -->
  <div class="kuitansi-box relative max-w-2xl w-full bg-white rounded-2xl border-2 border-slate-300 p-8 shadow-xl overflow-hidden">
    
    <!-- Watermark Lunas -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none opacity-5">
      <span class="text-9xl font-black rotate-[-25deg] tracking-widest text-emerald-950">LUNAS</span>
    </div>

    <!-- Kop Kuitansi -->
    <div class="flex items-center justify-between border-b-2 border-slate-800 pb-4">
      <div class="flex items-center gap-3">
        <div class="h-12 w-12 rounded-xl bg-brand-600 text-white flex items-center justify-center text-xl shadow-md">
          <i class="fa-solid fa-coins"></i>
        </div>
        <div>
          <h1 class="text-lg font-black text-slate-900 tracking-tight uppercase">PENGURUS KAS KELAS XII RPL 1</h1>
          <p class="text-xs text-slate-600 font-medium">SMK NEGERI REKAYASA PERANGKAT LUNAK &bull; TP 2026/2027</p>
        </div>
      </div>
      <div class="text-right">
        <div class="inline-block px-3 py-1 rounded bg-slate-900 text-white text-xs font-black tracking-widest uppercase">
          KUITANSI RESMI
        </div>
        <div class="text-[11px] font-mono text-slate-600 font-bold mt-1">No: <%= receiptNo %></div>
      </div>
    </div>

    <!-- Body Kuitansi -->
    <div class="mt-6 space-y-4 text-xs">
      
      <!-- Telah Terima Dari -->
      <div class="flex flex-col sm:flex-row sm:items-start">
        <span class="w-40 font-bold text-slate-700 shrink-0">Telah Terima Dari</span>
        <span class="hidden sm:inline mr-2">:</span>
        <div class="flex-1 font-extrabold text-slate-900 text-sm">
          <%= income.student ? income.student.nama : '-' %>
          <div class="text-xs font-normal text-slate-500 font-mono mt-0.5">
            NISN: <%= income.student ? income.student.nisn || '-' : '-' %> &bull; <%= income.student ? income.student.kelas || 'XII RPL 1' : '' %>
          </div>
        </div>
      </div>

      <!-- Uang Sejumlah -->
      <div class="flex flex-col sm:flex-row sm:items-start bg-slate-50 p-3 rounded-xl border border-slate-200">
        <span class="w-36 font-bold text-slate-700 shrink-0">Uang Sejumlah</span>
        <span class="hidden sm:inline mr-2">:</span>
        <div class="flex-1 font-bold italic text-slate-900 capitalize">
          # <%= nominalTerbilang %> #
        </div>
      </div>

      <!-- Untuk Pembayaran -->
      <div class="flex flex-col sm:flex-row sm:items-start">
        <span class="w-40 font-bold text-slate-700 shrink-0">Untuk Pembayaran</span>
        <span class="hidden sm:inline mr-2">:</span>
        <div class="flex-1 text-slate-800 font-semibold">
          <%= income.period ? income.period.namaPeriode : 'Iuran Kas Wajib' %>
          <% if (income.catatan) { %>
            <div class="text-[11px] text-slate-500 italic mt-0.5">Catatan: <%= income.catatan %></div>
          <% } %>
        </div>
      </div>

      <!-- Metode & Waktu -->
      <div class="flex flex-col sm:flex-row sm:items-start">
        <span class="w-40 font-bold text-slate-700 shrink-0">Metode &amp; Waktu</span>
        <span class="hidden sm:inline mr-2">:</span>
        <div class="flex-1 text-slate-700">
          <span class="font-bold text-slate-900"><%= income.metodeBayar || 'TUNAI' %></span> &bull; 
          <%= formatDate(income.tglBayar, 'full') %>
        </div>
      </div>

    </div>

    <!-- Nominal Card & Signatures -->
    <div class="mt-8 pt-6 border-t border-slate-200 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      
      <!-- Nominal Box -->
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider mb-1">JUMLAH DITERIMA:</div>
        <div class="inline-block px-4 py-2.5 rounded-xl bg-emerald-50 border-2 border-emerald-500 text-emerald-800 font-black text-xl tracking-tight shadow-inner">
          <%= formatRupiah(income.nominal) %>
        </div>
        <div class="mt-2 text-[10px] text-slate-400 font-mono">
          Status: <span class="font-bold text-emerald-600">TERVERIFIKASI LUNAS</span>
        </div>
      </div>

      <!-- Stamp and Signature -->
      <div class="text-center sm:text-right">
        <div class="text-xs text-slate-500">
          Diterima pada: <%= formatDate(income.tglBayar, 'full') %>
        </div>
        <div class="text-xs font-bold text-slate-800 mt-1">Bendahara Kelas XII RPL 1</div>
        
        <!-- Stempel Digital Mockup -->
        <div class="my-2 relative inline-flex items-center justify-center">
          <div class="h-16 w-32 border-2 border-red-500 rounded-lg flex flex-col items-center justify-center text-red-500 rotate-[-4deg] opacity-85 select-none">
            <span class="text-sm font-black tracking-widest uppercase">LUNAS</span>
            <span class="text-[8px] font-bold tracking-wider">KAS XII RPL 1</span>
          </div>
        </div>

        <div class="text-xs font-extrabold text-slate-900 underline">
          <%= income.bendahara ? income.bendahara.nama : 'Sarah Amelia Putri' %>
        </div>
        <div class="text-[10px] text-slate-400 font-mono">
          NISN. <%= income.bendahara ? income.bendahara.nisn || '0068492011' : '0068492011' %>
        </div>
      </div>

    </div>

    <!-- Security Footer -->
    <div class="mt-6 pt-4 border-t border-dashed border-slate-200 flex items-center justify-between text-[10px] text-slate-400">
      <div class="flex items-center gap-1.5">
        <i class="fa-solid fa-qrcode text-base text-slate-600"></i>
        <span>Digital Receipt Signature &bull; SiKas Pintar Verified</span>
      </div>
      <div>Dokumen ini sah dicetak sebagai bukti pembayaran kas kelas</div>
    </div>
  </div>

</body>
</html>
