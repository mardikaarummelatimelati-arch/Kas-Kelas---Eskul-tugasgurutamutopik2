{
  "name": "sistem-kas-kelas-ekskul",
  "version": "1.0.0",
  "description": "Sistem Manajemen Kas Kelas & Ekstrakurikuler Berbasis RBAC (Admin, Bendahara, Siswa)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js server.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:push": "node node_modules/prisma/build/index.js db push",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "node node_modules/prisma/build/index.js db push && node prisma/seed.js"
  },
  "keywords": [
    "kas-kelas",
    "ekskul",
    "rbac",
    "express",
    "prisma",
    "sqlite",
    "ejs",
    "tailwind"
  ],
  "author": "Tech Lead & Fullstack Engineer",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
